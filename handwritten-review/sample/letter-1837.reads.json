9, "extraction_score": 0.9}, "value": "discvssion", "citation": {"bbox": [49, 721, 122, 737], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}, "handwritten_text": {"score": {"grounding_score": 0.93, "extraction_score": 0.93}, "value": "discussion", "citation": {"bbox": [83, 715, 95, 728], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}}, {"kind": {"score": {"grounding_score": 0.88, "extraction_score": 0.76}, "value": "insertion", "citation": {"bbox": [105, 789, 333, 816], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}, "anchor": {"score": {"grounding_score": 0.97, "extraction_score": 0.97}, "value": "views from the beginning,", "citation": {"bbox": [440, 774, 609, 792], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}, "needs_review": {"score": {"grounding_score": 0.94, "extraction_score": 0.94}, "value": false, "citation": {"bbox": [105, 789, 333, 816], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}, "printed_text": {"score": {"grounding_score": 0.96, "extraction_score": 0.96}, "value": "", "citation": null}, "handwritten_text": {"score": {"grounding_score": 0.62, "extraction_score": 0.34}, "value": "1. Ellis Gray Loring.", "citation": {"bbox": [106, 790, 333, 817], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}}], "citation": null}, "redline": {"score": {"grounding_score": 0.18, "extraction_score": 0.12}, "value": "{++Faneuil Hall meeting Dec 8++}\n\nLIBRARY MHS\n\nSaturday Morning, {++[++}December 23, 1837.{++]++}\n\nMy Dear Sir,\n\nI am sorry to see that a meeting is advertised for tomorrow evening. I fear that the religiously disposed will not go out on Sunday evening. I beg, that as far as possible, all {~~preparations~>passionateness~~} may be avoided. I wish that you and Mr. Loring {++1++} would state distinctly the objects of the meeting which was petitioned for, that it was intended to be held under the influence of religion, that it was to begin and to close with supplication for God's blessing, that it was intended also to embrace all parties, that the Mayor was to be requested to preside (Am I not right in this?), etc. My earnest desire is that we may have a meeting which will unite the people of our city in the expression of the great principles in which they really concur, and for this end exasperating views of one or another party should {~~consistently be~>be conscientiously~~} kept out of sight. If the Abolitionists will now take a generous position, if they will come forward as advocates of free {~~discvssion~>discussion~~}, and as the settled foes of violence and mobs, and will stop here, they will not only acquire new confidence, but what is more important, will give a decided impulse to the great principles on which all our reformations and improvements must rest. If they try to mix up {~~thes~>this~~} meeting with Abolitionism, they will prevent a deep and {++cordial testimony++} against violence, and in favor of the rights of free {~~discvssion~>discussion~~} and the press. I wish of course to be kept out of sight as much as I can be. My present notoriety is painful enough. But if it is necessary, you can bear testimony to my views from the beginning,\n\n{++1. Ellis Gray Loring.++}", "citation": {"bbox": [46, 20, 611, 819], "page": 1, "page_width": 633.3599853515625, "page_height": 840.0}}}, "min_confidence_score": 0.1}, {"job_id": "3f79ec98-d0a4-4bf7-950f-a443eb9fdb63", "status": "completed", "file_name": "document.pdf", "created_at": "2026-10-01T13:13:16.129353+00:00", "updated_at": "2026-10-01T13:15:04.385529+00:00", "metadata": {"order": ["redline", "changes"], "schema": {"type": "object", "required": ["redline", "changes"], "properties": {"changes": {"type": "array", "items": {"type": "object", "required": ["kind", "printed_text", "handwritten_text", "anchor", "needs_review"], "properties": {"kind": {"enum": ["substitution", "deletion", "insertion", "comment"], "type": "string"}, "anc