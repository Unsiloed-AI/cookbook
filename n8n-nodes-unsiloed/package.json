{
  "name": "n8n-nodes-unsiloed",
  "version": "0.1.0",
  "description": "Unsiloed AI — parse and OCR documents (PDF, scans, images) into clean Markdown inside n8n",
  "keywords": [
    "n8n-community-node-package",
    "unsiloed",
    "ocr",
    "pdf",
    "document-ai",
    "parse"
  ],
  "license": "MIT",
  "homepage": "https://unsiloed.ai",
  "author": {
    "name": "Unsiloed AI"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unsiloed-AI/cookbook.git",
    "directory": "n8n-nodes-unsiloed"
  },
  "bugs": {
    "url": "https://github.com/Unsiloed-AI/cookbook/issues"
  },
  "engines": {
    "node": ">=18.10"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && npm run copy:icons",
    "copy:icons": "mkdir -p dist/nodes/Unsiloed && cp nodes/Unsiloed/*.png nodes/Unsiloed/*.json dist/nodes/Unsiloed/",
    "dev": "tsc --watch"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/UnsiloedApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Unsiloed/Unsiloed.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "n8n-workflow": "*",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
