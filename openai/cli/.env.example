# Drives the agent's reasoning (which tool to call, how to respond).
OPENAI_API_KEY=sk-...

# Does the actual document processing. Get one at https://www.unsiloed.ai
UNSILOED_API_KEY=your-unsiloed-key

# Optional overrides
# UNSILOED_MODEL=gpt-4o
# UNSILOED_OUTPUT_DIR=unsiloed_output
# UNSILOED_NATIVE_LOGO=1   # use the real `oh-my-logo` binary for the banner if installed
