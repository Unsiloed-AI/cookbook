# Unsiloed REST API key — https://unsiloed.ai  (sent as the `api-key` header, no OAuth)
UNSILOED_API_KEY=

# Daytona API key — https://app.daytona.io  (hosts the PDF at a public URL)
DAYTONA_API_KEY=

# --- optional ---------------------------------------------------------------
# Skip Daytona and point Unsiloed at any public URL:
# DOC_URL=

# Skip Daytona AND URLs — upload the file's bytes to Unsiloed's presigned endpoint:
# UNSILOED_USE_UPLOAD=1

# Override the Hermes Agent install that provides the MoA SDK (default below):
# HERMES_HOME=~/.hermes/hermes-agent